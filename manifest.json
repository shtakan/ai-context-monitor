{
  "manifest_version": 3,

  "//ESM": [
    "РЕШЕНИЕ (v2.0, этап 3/3): статические ES modules для content scripts НЕ используются —",
    "проверено на Chrome 153.0.8010.36 и Edge 153.0.4234.32. Ключ \"type\":\"module\" в",
    "content_scripts Chrome игнорирует ('Cannot use import statement outside a module'), а",
    "chrome.scripting.registerContentScripts отвергает поле 'type' схемой API ('Unexpected",
    "property: \"type\"') — и в world 'ISOLATED', и в world 'MAIN'. Поэтому content_scripts[0].js",
    "ниже остаётся классическим списком (порядок = порядок исполнения, единый скоуп через",
    "window.AiCm*), а реальные import ядра gemini-intercept отложены до введения БАНДЛЕРА",
    "(отдельное решение; в этом коммите бандлер не вводится).",
    "Обоснование и пробы — ARCHITECTURE_STANDARDS.md, раздел 'ES modules в content scripts'."
  ],

  "name": "__MSG_ext_name__",
  "version": "1.19.3",
  "description": "__MSG_ext_description__",
  "default_locale": "ru",

  "homepage_url": "https://github.com/user/ai-context-monitor",

  "permissions": [
    "scripting",
    "storage",
    "notifications"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://aistudio.google.com/*",
    "https://www.google.com/search*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],

  "background": {
    "service_worker": "core/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://aistudio.google.com/*",
    "https://www.google.com/search*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*"
  ],
  "js": [
    "utils/debug.js",
    "utils/tokenizer.js",
    "utils/model-config.js",
    "adapters/base-adapter.js",
    "adapters/chatgpt-adapter.js",
    "adapters/gemini-adapter.js",
    "adapters/deepseek-adapter.js",
    "adapters/google-search-adapter.js",
    "adapters/claude-adapter.js",
    "adapters/perplexity-adapter.js",
    "utils/gemini-dom-parser.js",
    "utils/gemini-batchexecute-parser.js",
    "utils/buildReferenceText.js",
    "utils/export-text-builders.js",
    "utils/export-emit-pipeline.js",
    "core/state.js",
    "core/widget.js",
    "core/base-handler.js",
    "core/hybrid-tail.js",
    "core/export-manager.js",
    "core/content.js"
  ],
  "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "options/options.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
